<UserControl
    x:Class="MovieTime.App.Controls.MoviePosterCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MoviePosterItemViewModel}"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <UserControl.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Play Movie"
                            Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Movie Details"
                            Command="{x:Bind ViewModel.DetailsCommand, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Remove from River Library"
                            Command="{x:Bind ViewModel.RemoveFromLibraryCommand, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Delete from Computer"
                            Foreground="#FF453A"
                            Command="{x:Bind ViewModel.DeleteFromDiskCommand, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" Foreground="#FF453A" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.ContextFlyout>

    <StackPanel Width="170" Spacing="8" Margin="0,8,16,14">
        <!-- 2:3 Vertical Movie Poster Card Area (170 x 255) -->
        <Grid x:Name="PosterContainer" Width="170" Height="255" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="PosterScale" ScaleX="1.0" ScaleY="1.0" />
            </Grid.RenderTransform>

            <!-- Drop shadow effect layer -->
            <Border x:Name="PosterShadow"
                    CornerRadius="14"
                    Background="#55000000"
                    Opacity="0.0"
                    Margin="-4,-4,-4,-4" />

            <!-- Poster Artwork / Base -->
            <Border CornerRadius="14" Background="{ThemeResource AppCardBackgroundBrush}">
                <Grid>
                    <!-- Typographical / Gradient Fallback Artwork (when no poster exists) -->
                    <Border x:Name="FallbackBorder"
                            Background="#1C1C26"
                            Visibility="{x:Bind ViewModel.NeedsFallback, Mode=OneWay}">
                        <Grid>
                            <!-- Ambient atmospheric gradient glow -->
                            <Border Opacity="0.45">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop Color="#3B3E5B" Offset="0" />
                                        <GradientStop Color="#14141E" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Year badge pill at top-left -->
                            <Border Visibility="{x:Bind ViewModel.HasYear, Mode=OneWay}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#60000000"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    Margin="8,8,0,0">
                                <TextBlock Text="{x:Bind ViewModel.YearDisplay, Mode=OneWay}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#CCCCCC" />
                            </Border>

                            <!-- Subtle film icon in center -->
                            <FontIcon Glyph="&#xE714;"
                                      FontSize="34"
                                      Foreground="#2C2C3E"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,20" />

                            <!-- Title snippet in fallback state -->
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#8A8A98"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,10,16"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                        </Grid>
                    </Border>

                    <!-- Genuine Local Extracted Poster Image -->
                    <Image x:Name="PosterImage"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasPoster, Mode=OneWay}" />

                    <!-- Quality Tag Badge (e.g. 4K HDR, 1080p) -->
                    <Border Visibility="{x:Bind ViewModel.HasQualityTag, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#80000000"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,8,8">
                        <TextBlock Text="{x:Bind ViewModel.QualityTag, Mode=OneWay}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#F0F0F0" />
                    </Border>
                </Grid>
            </Border>

            <!-- Focused State Border (Bright White Stroke) -->
            <Border x:Name="FocusBorder"
                    CornerRadius="14"
                    BorderBrush="#FFFFFF"
                    BorderThickness="3"
                    Opacity="0.0"
                    IsHitTestVisible="False" />
        </Grid>

        <!-- Movie Metadata below poster -->
        <StackPanel Spacing="2" Padding="2,0,0,0">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock Text="{x:Bind ViewModel.MetadataSubtitle, Mode=OneWay}"
                       FontSize="11"
                       Foreground="#8E8E93"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
        </StackPanel>
    </StackPanel>
</UserControl>
