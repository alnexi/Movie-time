<UserControl
    x:Class="MovieTime.App.Controls.HeroBannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:HeroBannerViewModel}">

    <Grid x:Name="RootHeroGrid" Height="480" Background="{ThemeResource AppBackgroundBrush}"
          ManipulationMode="TranslateX,System"
          ManipulationCompleted="OnHeroManipulationCompleted"
          PointerWheelChanged="OnHeroPointerWheelChanged"
          PointerEntered="OnHeroPointerEntered"
          PointerExited="OnHeroPointerExited">
        <!-- 1. Cinematic Backdrop Canvas -->
        <Grid x:Name="BackdropCanvas"
              Background="Transparent"
              PointerPressed="OnTitleOrBackdropPressed">
            <!-- Rich Ambient Dark Gradient (Cinematic lighting) -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.65,0.45" GradientOrigin="0.65,0.45" RadiusX="0.85" RadiusY="0.75">
                        <GradientStop Color="#4A2218" Offset="0" />
                        <GradientStop Color="#241012" Offset="0.5" />
                        <GradientStop Color="#0A0A0C" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Decorative Ambient Lighting Splashes -->
            <Border Opacity="0.35" HorizontalAlignment="Right" Width="600">
                <Border.Background>
                    <RadialGradientBrush Center="0.7,0.4" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#BA4A28" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Genuine Local Backdrop Image (when HasBackdrop is true) -->
            <Image x:Name="HeroBackdropImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.HasBackdrop, Mode=OneWay}" />

            <!-- Left Vignette Gradient: Guarantees title readability -->
            <Border IsHitTestVisible="False" Background="{ThemeResource AppBackdropVignetteLeftBrush}" />

            <!-- Bottom Vignette Gradient: Seamless fade into content rows below -->
            <Border IsHitTestVisible="False" Background="{ThemeResource AppBackdropVignetteBottomBrush}" />
        </Grid>

        <!-- 2. Hero Content Overlay -->
        <Grid Margin="48,80,48,36" IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Bottom" MaxWidth="580" Spacing="14" HorizontalAlignment="Left">
                <!-- Hero Title (Clicking opens details) -->
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           FontSize="40"
                           FontWeight="Black"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           PointerPressed="OnTitleOrBackdropPressed" />

                <!-- Genre & Metadata Badges -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Genre, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center" />

                    <!-- Rating / Year Badge -->
                    <Border Visibility="{x:Bind ViewModel.HasRatingBadge, Mode=OneWay}"
                            BorderBrush="#8E8E93"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.RatingBadge, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C7C7CC" />
                    </Border>

                    <!-- Quality Badge (e.g. 1080p, 4K) -->
                    <Border Visibility="{x:Bind ViewModel.HasQualityBadge, Mode=OneWay}"
                            BorderBrush="#8E8E93"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.QualityBadge, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C7C7CC" />
                    </Border>
                </StackPanel>

                <!-- Description / Edition -->
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                           FontSize="14"
                           Foreground="#B0B0B8"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           LineHeight="20" />

                <!-- Dual Action Buttons: Play Movie & Details -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                    <!-- Primary Play Button: Signature Capsule Pill -->
                    <Button Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                            Background="{ThemeResource AppButtonPrimaryBackgroundBrush}"
                            Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}"
                            CornerRadius="18"
                            Padding="24,10"
                            FontWeight="SemiBold"
                            FontSize="14"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Secondary Details Button -->
                    <Button Command="{x:Bind ViewModel.DetailsCommand, Mode=OneWay}"
                            Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                            Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}"
                            CornerRadius="18"
                            Padding="20,10"
                            FontWeight="Medium"
                            FontSize="14"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}" />
                            <TextBlock Text="Details" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 3. Dynamic Interactive Carousel Dots -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Dots, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasMultipleItems, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeroDotViewModel">
                        <Button Command="{x:Bind SelectCommand, Mode=OneWay}"
                                Padding="0" Margin="0" MinWidth="0" MinHeight="0"
                                BorderThickness="0" Background="Transparent">
                            <Border Width="{x:Bind Width, Mode=OneWay}"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#FFFFFF"
                                    Opacity="{x:Bind Opacity, Mode=OneWay}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
