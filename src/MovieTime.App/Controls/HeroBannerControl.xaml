<UserControl
    x:Class="MovieTime.App.Controls.HeroBannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:HeroBannerViewModel}">

    <Grid Height="480" Background="#0A0A0C">
        <!-- 1. Cinematic Backdrop Canvas -->
        <Grid>
            <!-- Rich Ambient Dark Gradient (Cinematic lighting reminiscent of Screenshot 1) -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.65,0.45" GradientOrigin="0.65,0.45" RadiusX="0.85" RadiusY="0.75">
                        <GradientStop Color="#4A2218" Offset="0" />
                        <GradientStop Color="#241012" Offset="0.5" />
                        <GradientStop Color="#0A0A0C" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Decorative Ambient Lighting Splashes -->
            <Border Opacity="0.35" HorizontalAlignment="Right" Width="600">
                <Border.Background>
                    <RadialGradientBrush Center="0.7,0.4" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#BA4A28" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Genuine Local Backdrop Image (when HasBackdrop is true) -->
            <Image x:Name="HeroBackdropImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.HasBackdrop, Mode=OneWay}" />

            <!-- Left Vignette Gradient: Guarantees title readability -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F00A0A0C" Offset="0" />
                        <GradientStop Color="#B00A0A0C" Offset="0.45" />
                        <GradientStop Color="#000A0A0C" Offset="0.85" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Bottom Vignette Gradient: Seamless fade into content rows below -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0A0C" Offset="0.55" />
                        <GradientStop Color="#A00A0A0C" Offset="0.85" />
                        <GradientStop Color="#FF0A0A0C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 2. Hero Content Overlay -->
        <Grid Margin="48,80,48,36">
            <StackPanel VerticalAlignment="Bottom" MaxWidth="560" Spacing="14" HorizontalAlignment="Left">
                <!-- Hero Title -->
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           FontSize="40"
                           FontWeight="Black"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxLines="2" />

                <!-- Genre & Metadata Badges -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Genre, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center" />

                    <!-- Rating Badge (e.g. [R]) -->
                    <Border Visibility="{x:Bind ViewModel.HasRatingBadge, Mode=OneWay}"
                            BorderBrush="#8E8E93"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.RatingBadge, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C7C7CC" />
                    </Border>

                    <!-- Quality Badge (e.g. 4K HDR) -->
                    <Border Visibility="{x:Bind ViewModel.HasQualityBadge, Mode=OneWay}"
                            BorderBrush="#8E8E93"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.QualityBadge, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C7C7CC" />
                    </Border>
                </StackPanel>

                <!-- Description / Cast -->
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                           FontSize="14"
                           Foreground="#B0B0B8"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           LineHeight="20" />

                <!-- Action Button: Apple TV Signature White Capsule Pill -->
                <Button Command="{x:Bind ViewModel.ActionCommand, Mode=OneWay}"
                        Background="#FFFFFF"
                        Foreground="#000000"
                        CornerRadius="18"
                        Padding="24,10"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.ActionButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 3. Apple TV Centered Carousel Dots -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4">
                <!-- Active dot capsule -->
                <Border Width="18" Height="4" CornerRadius="2" Background="#FFFFFF" />
                <!-- Inactive dots -->
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
                <Border Width="4" Height="4" CornerRadius="2" Background="#50FFFFFF" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
