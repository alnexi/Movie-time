<UserControl
    x:Class="MovieTime.App.Controls.SidebarNavigationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">

    <!-- Floating Frosted Glass Acrylic Panel (Signature Style) -->
    <Grid x:Name="SidebarContainer"
          Width="250"
          HorizontalAlignment="Left"
          VerticalAlignment="Stretch"
          Margin="24,20,0,24"
          RenderTransformOrigin="0,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="SidebarTranslate" TranslateX="-280" />
        </Grid.RenderTransform>

        <!-- Drop Shadow Layer -->
        <Border CornerRadius="22" Background="#60000000" Margin="-4,-4,-4,-4" />

        <!-- Frosted Glass Card -->
        <Border CornerRadius="22"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                Padding="16,18">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- 1. User Header: Profile Avatar, Username, Clock -->
                <Grid Grid.Row="0" Margin="4,0,4,18">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Profile Avatar Circle -->
                        <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AppGlassFillBrush}">
                            <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="River"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Time display on right -->
                    <TextBlock Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 2. Search Item -->
                <Button Grid.Row="1"
                        Command="{x:Bind ViewModel.SelectCategoryCommand}"
                        CommandParameter="Search"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="14,10"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="#B0B0B8" />
                        <TextBlock Text="Search" FontSize="14" Foreground="#B0B0B8" FontWeight="Medium" />
                    </StackPanel>
                </Button>

                <!-- 3. Navigation Stack (Home, Movies, TV Shows, Library) -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <!-- Home (Active: Solid White Pill with dark text) -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Home"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="#000000" />
                            <TextBlock Text="Home" FontSize="14" Foreground="#000000" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Movies -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Movies"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="#CCCCCC" />
                            <TextBlock Text="Movies" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- TV Shows -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="TV Shows"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="#CCCCCC" />
                            <TextBlock Text="TV Shows" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Library -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Library"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE838;" FontSize="16" Foreground="#CCCCCC" />
                            <TextBlock Text="Library" FontSize="14" Foreground="#CCCCCC" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 4. Bottom Controls: Scan / Refresh and Close -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshLibraryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#18FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE777;" FontSize="15" Foreground="#FFFFFF" />
                            <TextBlock Text="Scan &amp; Refresh" FontSize="13" Foreground="#FFFFFF" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.CloseSidebarCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="8,6">
                        <TextBlock Text="Close Sidebar" FontSize="12" Foreground="#8E8E93" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
