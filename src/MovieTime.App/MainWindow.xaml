<Window
    x:Class="MovieTime.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Movie Time">

    <Grid Background="#0D0D11">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="Movie Time"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Local Cinematic Media Experience"
                       FontSize="16"
                       Foreground="#8E8E93"
                       HorizontalAlignment="Center" />
            <Border Background="#1C1C24"
                    CornerRadius="8"
                    Padding="16,8"
                    HorizontalAlignment="Center">
                <TextBlock Text="Phase 0 Baseline • WinUI 3 Desktop • .NET 10 (x64)"
                           FontSize="12"
                           Foreground="#A1A1A6" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
