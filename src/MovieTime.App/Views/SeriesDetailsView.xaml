<UserControl
    x:Class="MovieTime.App.Views.SeriesDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SeriesDetailsViewModel}">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <!-- Main Scrollable Content Container -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Padding="0,0,0,60">

                <!-- ================= 1. CINEMATIC HERO SECTION ================= -->
                <Grid Height="460">
                    <!-- A. Background Artwork / Fallback Canvas -->
                    <Grid>
                        <!-- Genuine Local Backdrop Image (if exists) -->
                        <Image x:Name="HeroBackdropImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasBackdrop, Mode=OneWay}" />

                        <!-- Ambient Fallback Background (when no local backdrop exists) -->
                        <Border Visibility="{x:Bind ViewModel.NeedsBackdropFallback, Mode=OneWay}"
                                Background="#101018">
                            <Grid>
                                <!-- Atmospheric radial glow -->
                                <Border>
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.7,0.35" RadiusX="0.9" RadiusY="0.8">
                                            <GradientStop Color="#1A2230" Offset="0" />
                                            <GradientStop Color="#12151E" Offset="0.6" />
                                            <GradientStop Color="#0A0A0C" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>

                                <FontIcon Glyph="&#xE7F4;"
                                          FontSize="160"
                                          Foreground="#12121C"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,80,0" />
                            </Grid>
                        </Border>

                        <!-- Left Vignette Gradient: Guarantees title readability -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00A0A0C" Offset="0" />
                                    <GradientStop Color="#B80A0A0C" Offset="0.45" />
                                    <GradientStop Color="#300A0A0C" Offset="0.8" />
                                    <GradientStop Color="#000A0A0C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Bottom Vignette Gradient: Seamless fade into content below -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000A0A0C" Offset="0.4" />
                                    <GradientStop Color="#B00A0A0C" Offset="0.85" />
                                    <GradientStop Color="#FF0A0A0C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- B. Top Floating Back Button: TV Shows -->
                    <Button Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="36,24,0,0"
                            Background="#60181820"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,6,18,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="#C0C0C8" />
                            <TextBlock Text="TV Shows" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- C. Hero Content Information (Title, Badges, Next Up Button) -->
                    <Grid VerticalAlignment="Bottom" Margin="48,0,48,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Text Block -->
                        <StackPanel Grid.Column="0" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
                            <!-- Series Title -->
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />

                            <!-- Metadata Subtitle (Year • Seasons • Episodes) -->
                            <TextBlock Text="{x:Bind ViewModel.MetadataSubtitle, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="#8E8E93" />

                            <!-- Play / Resume Primary Action Button -->
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                                <Button Command="{x:Bind ViewModel.PlayNextUpCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.HasNextUpEpisode, Mode=OneWay}"
                                        Background="#FFFFFF"
                                        Foreground="#000000"
                                        BorderThickness="0"
                                        CornerRadius="22"
                                        Height="44"
                                        Padding="24,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#000000" />
                                        <TextBlock Text="{x:Bind ViewModel.NextUpActionText, Mode=OneWay}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#000000" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Poster Thumbnail (if available) -->
                        <Border Grid.Column="1"
                                Width="120"
                                Height="180"
                                CornerRadius="8"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                Background="#14141E"
                                Visibility="{x:Bind ViewModel.HasPoster, Mode=OneWay}"
                                VerticalAlignment="Bottom"
                                Margin="32,0,0,0">
                            <Image x:Name="PosterImage"
                                   Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= 2. SEASONS SELECTOR TABS ================= -->
                <Grid Margin="48,8,48,20">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SeasonTabs, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeasonTabViewModel">
                                <Button Command="{x:Bind SelectCommand}"
                                        Background="#20FFFFFF"
                                        CornerRadius="16"
                                        Padding="16,6"
                                        BorderThickness="0">
                                    <TextBlock Text="{x:Bind DisplayText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ================= 3. EPISODES LIST ================= -->
                <StackPanel Margin="48,0,48,0">
                    <!-- Heading -->
                    <TextBlock Text="{x:Bind ViewModel.SelectedSeason.Title, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,16" />

                    <!-- Episodes Horizontal/Wrap Grid -->
                    <GridView ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnEpisodeItemClick"
                              Padding="0,0,0,16">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               MaximumRowsOrColumns="-1"
                                               ItemWidth="300"
                                               ItemHeight="240" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EpisodeItemViewModel">
                                <Button Command="{x:Bind PlayCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="8,8,8,16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="168" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Episode Thumbnail (16:9 Aspect Ratio) -->
                                        <Border Grid.Row="0"
                                                CornerRadius="8"
                                                BorderBrush="#20FFFFFF"
                                                BorderThickness="1"
                                                Background="#14141E">
                                            <Grid CornerRadius="8">
                                                <!-- Extracted Thumbnail Image -->
                                                <Image Source="{x:Bind ThumbnailPath, Mode=OneWay}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind HasThumbnail, Mode=OneWay}" />

                                                <!-- Fallback Ambient Canvas -->
                                                <Border Visibility="{x:Bind NeedsFallback, Mode=OneWay}"
                                                        Background="#181824">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE714;"
                                                                  FontSize="36"
                                                                  Foreground="#20FFFFFF"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind DisplayTitle}"
                                                                   FontSize="12"
                                                                   Foreground="#8E8E93"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Bottom"
                                                                   Margin="8" />
                                                    </Grid>
                                                </Border>

                                                <!-- Play Hover Overlay -->
                                                <Border Background="#40000000"
                                                        CornerRadius="8">
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="20"
                                                            Background="#60000000"
                                                            BorderBrush="#40FFFFFF"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE768;"
                                                                  FontSize="14"
                                                                  Foreground="#FFFFFF"
                                                                  Margin="2,0,0,0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Border>
                                                </Border>

                                                <!-- Playback Progress Bar (at bottom of thumbnail) -->
                                                <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                             Minimum="0"
                                                             Maximum="1"
                                                             Visibility="{x:Bind HasProgress, Mode=OneWay}"
                                                             Foreground="#FFFFFF"
                                                             Background="#40FFFFFF"
                                                             Height="3"
                                                             VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Border>

                                        <!-- Episode Title & Number -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{x:Bind DisplayTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,2" />

                                        <!-- Episode Subtitle (Duration / Quality) -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DurationDisplay}"
                                                       FontSize="12"
                                                       Foreground="#8E8E93"
                                                       Visibility="{x:Bind HasDuration, Mode=OneWay}" />
                                            <Border Background="#20FFFFFF"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Visibility="{x:Bind HasQualityBadge, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind QualityBadge}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C0C0C8" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
