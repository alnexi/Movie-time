<UserControl
    x:Class="MovieTime.App.Views.MoviesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MovieTime.App.Controls"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MoviesViewModel}">

    <Grid Background="#0A0A0C">
        <Grid.RowDefinitions>
            <!-- 1. Header Bar: Floating Library Pill, Title, Search, Sort -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Split Area: Left Categories + Right Poster Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Grid Grid.Row="0" Margin="36,24,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top-Left Apple TV Floating Pill Button: ( 🗂️ Library ) - Screenshot 1 & 3 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.NavigateHomeCommand, Mode=OneWay}"
                        Background="#60181820"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="12,6,16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="#C0C0C8" />
                        <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="#FFFFFF" />
                        <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                </Button>

                <!-- Screen Title -->
                <TextBlock Text="Movies"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search Box & Sort Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Search Box Pill -->
                <Border Background="#1C1C24"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17"
                        Height="34"
                        Width="220"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE721;"
                                  FontSize="13"
                                  Foreground="#8E8E93"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                 TextChanged="OnSearchTextChanged"
                                 PlaceholderText="Search movies..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Foreground="#FFFFFF"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Sort Pill Buttons (Title / Year / Recent) -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.SetSortCommand, Mode=OneWay}"
                            CommandParameter="Title"
                            Background="#18FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="10,5">
                        <TextBlock Text="A-Z" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SetSortCommand, Mode=OneWay}"
                            CommandParameter="Year"
                            Background="#18FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="10,5">
                        <TextBlock Text="Year" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SetSortCommand, Mode=OneWay}"
                            CommandParameter="RecentlyAdded"
                            Background="#18FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="10,5">
                        <TextBlock Text="Recent" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" />
                    </Button>
                </StackPanel>

                <!-- Movie Count Badge -->
                <Border Background="#14141C"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,5">
                    <TextBlock Text="{x:Bind ViewModel.MovieCountSummary, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#8E8E93" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= MAIN SPLIT CONTENT AREA ================= -->
        <Grid Grid.Row="1" Margin="36,0,0,0">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Category Filter Panel (Screenshot 1 & 2) -->
                <ColumnDefinition Width="220" />
                <!-- Column 1: Poster Grid Canvas -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Library Categories / Filter List -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,16,24">
                <StackPanel Spacing="3">
                    <!-- Category Item: All Movies -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="All"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Grid.Column="0" Glyph="&#xE714;" FontSize="14" Foreground="#000000" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="All Movies" FontSize="13" FontWeight="SemiBold" Foreground="#000000" />
                        </Grid>
                    </Button>

                    <!-- Category Item: Recently Added -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Recent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="14" Foreground="#CCCCCC" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Recently Added" FontSize="13" FontWeight="Medium" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Category Item: 4K & HD -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="4K"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="14" Foreground="#CCCCCC" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="4K &amp; HD" FontSize="13" FontWeight="Medium" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- GENRES Header (Apple TV Section Header Style) -->
                    <TextBlock Text="GENRES"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#6E6E78"
                               Margin="8,16,0,4" />

                    <!-- Action & Adventure -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Action"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,7">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE735;" FontSize="13" Foreground="#B0B0B8" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Action &amp; Adventure" FontSize="12" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Comedy -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Comedy"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,7">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE76E;" FontSize="13" Foreground="#B0B0B8" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Comedy" FontSize="12" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Drama -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Drama"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,7">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="13" Foreground="#B0B0B8" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Drama" FontSize="12" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Kids & Family -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="Kids"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,7">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE776;" FontSize="13" Foreground="#B0B0B8" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Kids &amp; Family" FontSize="12" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Sci-Fi & Fantasy -->
                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand}"
                            CommandParameter="SciFi"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="12,7">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Grid.Column="0" Glyph="&#xE781;" FontSize="13" Foreground="#B0B0B8" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Sci-Fi &amp; Fantasy" FontSize="12" Foreground="#CCCCCC" />
                        </Grid>
                    </Button>

                    <!-- Library Management Buttons -->
                    <Border Margin="0,20,0,0" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel Spacing="6">
                            <Button Command="{x:Bind ViewModel.ManageLibrariesCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="#18FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Manage Libraries" FontSize="12" Foreground="#FFFFFF" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.RefreshLibraryCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE777;" FontSize="13" Foreground="#B0B0B8" />
                                    <TextBlock Text="Scan &amp; Refresh" FontSize="12" Foreground="#CCCCCC" FontWeight="Normal" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Right Movie Poster Grid Canvas -->
            <Grid Grid.Column="1">
                <!-- A. Empty Library State (Section 5) -->
                <Grid Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,48,60">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <!-- Film Glyph Badge -->
                        <Border Width="64"
                                Height="64"
                                CornerRadius="32"
                                Background="#1A1A26"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE714;" FontSize="28" Foreground="#8A8AAB" />
                        </Border>

                        <TextBlock Text="Your Movie Library is Empty"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Movie Time scans strictly inside designated MLibrary folders on your registered storage drives. Configure your drives in Settings to catalog your movies."
                                   FontSize="13"
                                   Foreground="#8E8E93"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="440"
                                   HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Command="{x:Bind ViewModel.ManageLibrariesCommand}"
                                    Background="#FFFFFF"
                                    Foreground="#000000"
                                    CornerRadius="18"
                                    Padding="22,10"
                                    FontWeight="SemiBold"
                                    FontSize="13">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" />
                                    <TextBlock Text="Manage Libraries" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.RefreshLibraryCommand}"
                                    Background="#25FFFFFF"
                                    Foreground="#FFFFFF"
                                    CornerRadius="18"
                                    Padding="18,10"
                                    FontWeight="Medium"
                                    FontSize="13">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="13" />
                                    <TextBlock Text="Scan Now" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- B. Real Movie Poster Grid (Screenshot 1) -->
                <GridView ItemsSource="{x:Bind ViewModel.DisplayedMovies, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnMovieItemClick"
                          Padding="0,0,36,40">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoviePosterItemViewModel">
                            <controls:MoviePosterCardControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <!-- ================= 3. APPLE TV QUICK ACTION CONTEXT DIALOG (Screenshot 3) ================= -->
        <Grid Grid.RowSpan="2"
              Visibility="{x:Bind ViewModel.IsQuickActionOpen, Mode=OneWay}"
              Background="#60000000">

            <!-- Modal Dismiss Layer -->
            <Border Background="Transparent"
                    PointerPressed="OnBackdropPointerPressed" />

            <!-- Frosted Capsule Action Menu -->
            <Border Width="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="#F0181822"
                    BorderBrush="#35FFFFFF"
                    BorderThickness="1"
                    Padding="20,18">
                <StackPanel Spacing="10">
                    <!-- Selected Movie Header -->
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="{x:Bind ViewModel.SelectedMovie.Title, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedMovie.MetadataSubtitle, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- Action 1: Play (Triangle Glyph) -->
                    <Button Command="{x:Bind ViewModel.PlayMovieCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#22FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#FFFFFF" />
                            <TextBlock Text="Play" FontSize="14" FontWeight="Medium" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>

                    <!-- Action 2: Go to Movie (Apple TV Signature White Pill - Screenshot 3) -->
                    <Button Command="{x:Bind ViewModel.GoToDetailsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#000000" />
                            <TextBlock Text="Go to Movie" FontSize="14" FontWeight="SemiBold" Foreground="#000000" />
                        </StackPanel>
                    </Button>

                    <!-- Status / Feedback Message -->
                    <Border Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                            Background="#20FFFFFF"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="#E0E0E0"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Close / Dismiss -->
                    <Button Command="{x:Bind ViewModel.DismissQuickActionCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,4,0,0">
                        <TextBlock Text="Dismiss" FontSize="12" Foreground="#8E8E93" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
