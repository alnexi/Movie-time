<UserControl
    x:Class="MovieTime.App.Views.PlaylistsView"
    x:Name="PlaylistsRootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    xmlns:entities="using:MovieTime.Core.Entities"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:PlaylistsViewModel}">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Grid Grid.Row="0" Margin="36,24,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top-Left Navigation Pill & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.NavigateHomeCommand, Mode=OneWay}"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,6,18,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Playlists"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Top-Right Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.OpenCreateDialogCommand, Mode=OneWay}"
                        Background="{ThemeResource AppTextPrimaryBrush}"
                        Foreground="{ThemeResource AppBackgroundBrush}"
                        CornerRadius="18"
                        Padding="16,8"
                        FontWeight="SemiBold"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="New Playlist" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= MAIN CONTENT SPLIT ================= -->
        <Grid Grid.Row="1" Margin="36,0,36,24">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Playlists List -->
                <ColumnDefinition Width="280" />
                <!-- Column 1: Playlist Details -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Playlists Sidebar -->
            <Border Grid.Column="0"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12"
                    Margin="0,0,16,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="YOUR PLAYLISTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Margin="8,4,8,12" />

                    <!-- Empty Playlists Guidance -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.HasPlaylists, Mode=OneWay, Converter={StaticResource InverseBoolVisibilityConverter}, FallbackValue=Collapsed}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Playlists Yet" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Create a playlist to group movies." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Playlists List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPlaylist, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Playlist">
                                <Grid Padding="6,8" ColumnDefinitions="Auto,*">
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource AppTextSecondaryBrush}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 2. Playlist Details / Ordered Movies Canvas -->
            <Border Grid.Column="1"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24">
                <Grid>
                    <!-- State A: Playlist Selected -->
                    <Grid Visibility="{x:Bind ViewModel.HasSelectedPlaylist, Mode=OneWay}"
                          RowDefinitions="Auto,*">

                        <!-- Playlist Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedPlaylistName, Mode=OneWay}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentItems.Count, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Play All Capsule -->
                                <Button Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                                        Background="{ThemeResource AppTextPrimaryBrush}"
                                        Foreground="{ThemeResource AppBackgroundBrush}"
                                        CornerRadius="18"
                                        Padding="20,9"
                                        FontWeight="SemiBold"
                                        FontSize="13">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="Play All" />
                                    </StackPanel>
                                </Button>

                                <!-- Rename -->
                                <Button Command="{x:Bind ViewModel.OpenRenameDialogCommand, Mode=OneWay}"
                                        Background="{ThemeResource AppGlassFillBrush}"
                                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="14,9"
                                        FontSize="13">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                                        <TextBlock Text="Rename" />
                                    </StackPanel>
                                </Button>

                                <!-- Delete -->
                                <Button Command="{x:Bind ViewModel.DeleteSelectedCommand, Mode=OneWay}"
                                        Background="#25FF453A"
                                        Foreground="#FF453A"
                                        BorderBrush="#40FF453A"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="14,9"
                                        FontSize="13">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State in Playlist -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="{x:Bind ViewModel.IsEmptyPlaylist, Mode=OneWay}">
                            <FontIcon Glyph="&#xE714;" FontSize="44" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="This Playlist is Empty" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Go to Movie Details in the Library and click 'Add to Playlist' to include movies here."
                                       FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
                        </StackPanel>

                        <!-- Ordered Movies List -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.CurrentItems, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.IsEmptyPlaylist, Mode=OneWay, Converter={StaticResource InverseBoolVisibilityConverter}, FallbackValue=Visible}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistDetailItemViewModel">
                                    <Border Background="{ThemeResource AppGlassFillBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Index & Poster -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SortOrder, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                           Width="24"
                                                           VerticalAlignment="Center" />

                                                <Border Width="42" Height="62" CornerRadius="6" Background="#14141C">
                                                    <Image Source="{x:Bind PosterPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Movie Title & Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0" Spacing="3">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind YearDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <Border Visibility="{x:Bind IsMissing, Mode=OneWay}" Background="#25FF453A" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="File Missing" FontSize="10" Foreground="#FF453A" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ordering and Play Controls -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Play this movie -->
                                                <Button Command="{Binding ElementName=PlaylistsRootView, Path=ViewModel.PlayItemCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="{ThemeResource AppTextPrimaryBrush}"
                                                        Foreground="{ThemeResource AppBackgroundBrush}"
                                                        Width="36" Height="36"
                                                        CornerRadius="18"
                                                        Padding="0">
                                                    <FontIcon Glyph="&#xE768;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Move Up -->
                                                <Button Command="{Binding ElementName=PlaylistsRootView, Path=ViewModel.MoveItemUpCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="{ThemeResource AppGlassFillBrush}"
                                                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                        Width="36" Height="36"
                                                        CornerRadius="18"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Move Up">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Move Down -->
                                                <Button Command="{Binding ElementName=PlaylistsRootView, Path=ViewModel.MoveItemDownCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="{ThemeResource AppGlassFillBrush}"
                                                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                        Width="36" Height="36"
                                                        CornerRadius="18"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Move Down">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Remove -->
                                                <Button Command="{Binding ElementName=PlaylistsRootView, Path=ViewModel.RemoveItemCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="#18FF453A"
                                                        Foreground="#FF453A"
                                                        Width="36" Height="36"
                                                        CornerRadius="18"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Remove from Playlist">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- State B: No Playlist Selected -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="14"
                                Visibility="{x:Bind ViewModel.HasSelectedPlaylist, Mode=OneWay, Converter={StaticResource InverseBoolVisibilityConverter}, FallbackValue=Collapsed}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="54" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select or Create a Playlist" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Organize movies into custom collections and watch them sequentially with seamless embedded playback."
                                   FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" />
                        <Button Command="{x:Bind ViewModel.OpenCreateDialogCommand, Mode=OneWay}"
                                Background="{ThemeResource AppTextPrimaryBrush}"
                                Foreground="{ThemeResource AppBackgroundBrush}"
                                CornerRadius="18"
                                Padding="20,10"
                                FontWeight="SemiBold"
                                FontSize="14"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Create First Playlist" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CREATE PLAYLIST POPUP ================= -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{x:Bind ViewModel.IsCreateDialogOpen, Mode=OneWay}">
            <Border Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="New Playlist" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.CreateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Playlist name..."
                             FontSize="14" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{x:Bind ViewModel.CloseCreateDialogCommand, Mode=OneWay}"
                                Content="Cancel"
                                Background="Transparent"
                                Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <Button Command="{x:Bind ViewModel.ConfirmCreateCommand, Mode=OneWay}"
                                Content="Create"
                                Background="{ThemeResource AppTextPrimaryBrush}"
                                Foreground="{ThemeResource AppBackgroundBrush}"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= RENAME PLAYLIST POPUP ================= -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{x:Bind ViewModel.IsRenameDialogOpen, Mode=OneWay}">
            <Border Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Rename Playlist" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.RenameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="New playlist name..."
                             FontSize="14" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{x:Bind ViewModel.CloseRenameDialogCommand, Mode=OneWay}"
                                Content="Cancel"
                                Background="Transparent"
                                Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <Button Command="{x:Bind ViewModel.ConfirmRenameCommand, Mode=OneWay}"
                                Content="Save"
                                Background="{ThemeResource AppTextPrimaryBrush}"
                                Foreground="{ThemeResource AppBackgroundBrush}"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
