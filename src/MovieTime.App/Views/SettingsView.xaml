<UserControl
    x:Class="MovieTime.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MovieTime.App.ViewModels"
    xmlns:models="using:MovieTime.Core.Library.Models"
    xmlns:controls="using:MovieTime.App.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <!-- 1. Top Header Bar with Segmented Tabs -->
        <Grid Height="72" VerticalAlignment="Top" Margin="36,24,36,0">
            <!-- Left: Capsule Pill Settings & Navigation Quick Shortcuts -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{ThemeResource AppPillInactiveBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,7,18,7">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Navigation Quick Shortcuts -->
                <Button Command="{x:Bind ViewModel.NavigateHomeCommand, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="#8E8E93" />
                        <TextBlock Text="Home" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.NavigateMoviesCommand, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="#8E8E93" />
                        <TextBlock Text="Movies" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Center: Segmented Tabs [ Media Libraries & Storage ] [ Theme Experience ] -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AppPillInactiveBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Tab 1 Button: General / Storage -->
                    <Grid>
                        <Button Command="{x:Bind ViewModel.SelectGeneralTabCommand, Mode=OneWay}"
                                Background="Transparent"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                BorderThickness="0"
                                CornerRadius="16"
                                Padding="16,8"
                                Visibility="{x:Bind BoolToInvertedVisibility(ViewModel.IsGeneralTabSelected), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="Media Libraries &amp; Storage" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.SelectGeneralTabCommand, Mode=OneWay}"
                                Background="{ThemeResource AppTextPrimaryBrush}"
                                Foreground="{ThemeResource AppBackgroundBrush}"
                                BorderThickness="0"
                                CornerRadius="16"
                                Padding="16,8"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsGeneralTabSelected), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="Media Libraries &amp; Storage" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Tab 2 Button: Theme Experience -->
                    <Grid>
                        <Button Command="{x:Bind ViewModel.SelectThemeTabCommand, Mode=OneWay}"
                                Background="Transparent"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                BorderThickness="0"
                                CornerRadius="16"
                                Padding="16,8"
                                Visibility="{x:Bind BoolToInvertedVisibility(ViewModel.IsThemeTabSelected), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE790;" FontSize="13" />
                                <TextBlock Text="Theme Experience" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.SelectThemeTabCommand, Mode=OneWay}"
                                Background="{ThemeResource AppTextPrimaryBrush}"
                                Foreground="{ThemeResource AppBackgroundBrush}"
                                BorderThickness="0"
                                CornerRadius="16"
                                Padding="16,8"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsThemeTabSelected), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE790;" FontSize="13" />
                                <TextBlock Text="Theme Experience" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: Status / Progress Indicator -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="16" Height="16" Foreground="#FFFFFF" />
                <TextBlock Text="Scanning Libraries..." FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 2. Main Scrollable Content Area -->
        <ScrollViewer Margin="36,104,36,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="880" HorizontalAlignment="Left">

                <!-- ============================================================== -->
                <!-- TAB 2: THEME EXPERIENCE (Primary Visual Focus - No Headings)   -->
                <!-- ============================================================== -->
                <StackPanel Spacing="16"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsThemeTabSelected), Mode=OneWay}">
                    <!-- Featured Atmosphere Card -->
                    <Border Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- Left: Interactive Canvas Controller -->
                            <controls:PixelDitherThemeControl Grid.Column="0"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Top" />

                            <!-- Right: Atmosphere State, Presets & Controls -->
                            <StackPanel Grid.Column="1" Margin="32,0,0,0" Spacing="24" VerticalAlignment="Top">
                                <!-- Mode & Percentage Badge -->
                                <Border Background="{ThemeResource AppGlassFillBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16,14">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind ViewModel.ThemeModeTitle, Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <Border Grid.Column="1"
                                                    Background="#25FFFFFF"
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,4">
                                                <TextBlock Text="{x:Bind ViewModel.ThemePercentageText, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AppAccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.ThemeDescription, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18" />
                                    </StackPanel>
                                </Border>

                                <!-- Quick Atmosphere Presets -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ATMOSPHERE PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Command="{x:Bind ViewModel.SetDayThemeCommand, Mode=OneWay}"
                                                Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                CornerRadius="16"
                                                Padding="14,8"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE706;" FontSize="13" />
                                                <TextBlock Text="Day (0%)" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{x:Bind ViewModel.SetTwilightThemeCommand, Mode=OneWay}"
                                                Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                CornerRadius="16"
                                                Padding="14,8"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE708;" FontSize="13" />
                                                <TextBlock Text="Twilight (50%)" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{x:Bind ViewModel.SetNightThemeCommand, Mode=OneWay}"
                                                Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                CornerRadius="16"
                                                Padding="14,8"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEC46;" FontSize="13" />
                                                <TextBlock Text="Night (100%)" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Motion & Accessibility Controls -->
                                <StackPanel Spacing="14">
                                    <TextBlock Text="ACCESSIBILITY &amp; MOTION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />

                                    <ToggleSwitch Header="Reduced Motion"
                                                  IsOn="{x:Bind ViewModel.ReducedMotion, Mode=TwoWay}"
                                                  OffContent="Disabled"
                                                  OnContent="Enabled"
                                                  Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                  FontSize="13" />

                                    <ToggleSwitch Header="Ambient Water Shimmer"
                                                  IsOn="{x:Bind ViewModel.AmbientAnimationEnabled, Mode=TwoWay}"
                                                  OffContent="Paused"
                                                  OnContent="Active"
                                                  Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                  FontSize="13" />
                                </StackPanel>

                                <!-- Keyboard Navigation Tip -->
                                <Border Background="{ThemeResource AppSurfaceSubtleBrush}"
                                        CornerRadius="10"
                                        Padding="14,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE765;" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        <TextBlock Text="Keyboard shortcuts: Click canvas, then use Up/Down arrows to adjust by 5%, Page Up/Down by 20%, Home/End for Day/Night."
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============================================================== -->
                <!-- TAB 1: MEDIA LIBRARIES & STORAGE SETTINGS                      -->
                <!-- ============================================================== -->
                <StackPanel Spacing="28"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsGeneralTabSelected), Mode=OneWay}">
                    <!-- Title & Section Header -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Media Libraries &amp; Storage"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="River organizes movies across your local drives using dedicated MLibrary folders. Only files inside registered MLibrary directories are scanned and cataloged."
                                   FontSize="13"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   MaxWidth="780" />
                    </StackPanel>

                <!-- Global Action Bar -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <Button Command="{x:Bind ViewModel.OpenAddDialogCommand, Mode=OneWay}"
                                Background="{ThemeResource AppButtonPrimaryBackgroundBrush}"
                                Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}"
                                CornerRadius="16"
                                Padding="18,8"
                                FontWeight="SemiBold"
                                FontSize="13"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}" />
                                <TextBlock Text="Add Drive Library" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ScanAllLibrariesCommand, Mode=OneWay}"
                                Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                                Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}"
                                CornerRadius="16"
                                Padding="16,8"
                                FontWeight="Medium"
                                FontSize="13"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.HasRegisteredLibraries, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}" />
                                <TextBlock Text="Scan All Libraries" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Status Notification Message Banner -->
                    <Border Grid.Column="2"
                            Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                            Background="#18FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#C0C0C8" />
                    </Border>
                </Grid>

                <!-- Section: Registered MLibrary Drives -->
                <StackPanel Spacing="14">
                    <TextBlock Text="REGISTERED STORAGE DRIVES"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               CharacterSpacing="80" />

                    <!-- Empty State: No Libraries Registered Yet -->
                    <Border Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="36,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <Border Width="60"
                                    Height="60"
                                    CornerRadius="30"
                                    Background="{ThemeResource AppSurfaceSubtleBrush}"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="26" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Border>

                            <TextBlock Text="No Storage Drives Registered"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="To start building your library, select a drive to host an MLibrary folder. Place movie files into the folder and River will discover them automatically."
                                       FontSize="13"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="460"
                                       HorizontalAlignment="Center" />

                            <Button Command="{x:Bind ViewModel.OpenAddDialogCommand, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource AppButtonPrimaryBackgroundBrush}"
                                Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}"
                                CornerRadius="16"
                                Padding="20,9"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}" />
                                    <TextBlock Text="Add Your First Drive" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Populated State: Registered MLibrary Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RegisteredLibraries, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasRegisteredLibraries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegisteredMLibraryViewModel">
                                <Border Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="20,16"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Left Info: Drive Name, Path, Last Scanned -->
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />

                                                <!-- Status Badges -->
                                                <!-- Available (Green) -->
                                                <Border Visibility="{x:Bind IsAvailableState, Mode=OneWay}"
                                                        Background="#2530D158"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#30D158" />
                                                        <TextBlock Text="Available" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Folder Missing (Orange) -->
                                                <Border Visibility="{x:Bind IsMissingFolderState, Mode=OneWay}"
                                                        Background="#25FF9F0A"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="#FF9F0A" />
                                                        <TextBlock Text="Folder Missing" FontSize="11" FontWeight="SemiBold" Foreground="#FF9F0A" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Disconnected (Red) -->
                                                <Border Visibility="{x:Bind IsDisconnectedState, Mode=OneWay}"
                                                        Background="#25FF453A"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xEB90;" FontSize="10" Foreground="#FF453A" />
                                                        <TextBlock Text="Drive Disconnected" FontSize="11" FontWeight="SemiBold" Foreground="#FF453A" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Disabled (Gray) -->
                                                <Border Visibility="{x:Bind IsDisabledState, Mode=OneWay}"
                                                        Background="#258E8E93"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#8E8E93" />
                                                        <TextBlock Text="Disabled" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Path info -->
                                            <TextBlock Text="{x:Bind Path, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontFamily="Consolas, Segoe UI"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />

                                            <!-- Last Scanned info -->
                                            <TextBlock Text="{x:Bind LastScannedDisplay, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Right Actions: Scan, Toggle, Remove -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Command="{x:Bind ScanCommand}"
                                                    IsEnabled="{x:Bind CanScan, Mode=OneWay}"
                                                    Background="{ThemeResource AppButtonSecondaryBackgroundBrush}"
                                                    Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}"
                                                    CornerRadius="12"
                                                    Padding="12,6"
                                                    FontSize="12">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="{ThemeResource AppButtonSecondaryForegroundBrush}" />
                                                    <TextBlock Text="Scan" />
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{x:Bind RemoveCommand}"
                                                    Background="#15FF453A"
                                                    Foreground="#FF6961"
                                                    BorderBrush="#25FF453A"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,6"
                                                    FontSize="12">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF6961" />
                                                    <TextBlock Text="Remove" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Information Section: How MLibrary Works -->
                <Border Background="{ThemeResource AppSurfaceSubtleBrush}"
                        BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24,20"
                        Margin="0,12,0,40">
                    <StackPanel Spacing="10">
                        <TextBlock Text="HOW STORAGE LIBRARIES WORK"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                   CharacterSpacing="80" />
                        <TextBlock Text="• Dedicated Folders: River only scans the 'MLibrary' folder on each selected drive (e.g. D:\MLibrary). It will never scan your drive root or personal documents."
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   LineHeight="18" />
                        <TextBlock Text="• Offline and Private: All media scanning and filename parsing runs locally on your machine with zero external network tracking."
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   LineHeight="18" />
                        <TextBlock Text="• Safe Removal: Removing a library from River unregisters the folder from the catalog. Your movie files on disk are never modified or deleted."
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   LineHeight="18" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 3. Add Drive Modal Dialog Backdrop Overlay -->
        <Grid Visibility="{x:Bind ViewModel.IsAddDialogOpen, Mode=OneWay}"
              Background="{ThemeResource AppOverlayBrush}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Centered Modal Card -->
            <Border Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28,26">
                <StackPanel Spacing="18">

                    <!-- Dialog Header -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Add Drive Library"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Select a storage drive to host your dedicated MLibrary folder."
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Drive Selection ComboBox -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Storage Drive"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />

                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Background="{ThemeResource AppInputBackgroundBrush}"
                                  BorderBrush="{ThemeResource AppBorderBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DriveStorageInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="—" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind CapacitySummary}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Target Path Preview Box -->
                    <Border Background="{ThemeResource AppInputBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="TARGET FOLDER PATH"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                                       CharacterSpacing="80" />
                            <TextBlock Text="{x:Bind ViewModel.PreviewTargetPath, Mode=OneWay}"
                                       FontSize="13"
                                       FontFamily="Consolas, Segoe UI"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Case A: Folder already exists on drive -->
                    <Border Visibility="{x:Bind ViewModel.PreviewFolderExists, Mode=OneWay}"
                            Background="#1830D158"
                            BorderBrush="#3030D158"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#30D158" />
                            <TextBlock Text="MLibrary folder already exists on this drive and will be linked."
                                       FontSize="12"
                                       Foreground="#30D158"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Case B: Folder does not exist on disk, confirmation required -->
                    <Border Visibility="{x:Bind ViewModel.PreviewNeedsCreation, Mode=OneWay}"
                            Background="#18FF9F0A"
                            BorderBrush="#30FF9F0A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FF9F0A" />
                                <TextBlock Text="Folder does not exist yet"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9F0A" />
                            </StackPanel>
                            <TextBlock Text="The 'MLibrary' directory does not exist on this drive yet. Please confirm that you would like River to create it for you."
                                       FontSize="11"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />
                            <CheckBox IsChecked="{x:Bind ViewModel.ConfirmCreateFolder, Mode=TwoWay}"
                                      Content="Create MLibrary folder on this drive"
                                      Foreground="#FFFFFF"
                                      FontSize="12"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Case C: Error or Already Registered -->
                    <Border Visibility="{x:Bind ViewModel.HasPreviewError, Mode=OneWay}"
                            Background="#20FF453A"
                            BorderBrush="#35FF453A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="#FF453A" />
                            <TextBlock Text="{x:Bind ViewModel.PreviewErrorMessage, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="#FF453A"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Dialog Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.CloseAddDialogCommand, Mode=OneWay}"
                                Background="Transparent"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                CornerRadius="14"
                                Padding="16,8"
                                FontSize="13"
                                Margin="0,0,8,0">
                            <TextBlock Text="Cancel" />
                        </Button>

                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.ConfirmAddLibraryCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanConfirmAdd, Mode=OneWay}"
                                Background="{ThemeResource AppButtonPrimaryBackgroundBrush}"
                                Foreground="{ThemeResource AppButtonPrimaryForegroundBrush}"
                                CornerRadius="14"
                                Padding="20,8"
                                FontWeight="SemiBold"
                                FontSize="13">
                            <TextBlock Text="Register Drive" />
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
