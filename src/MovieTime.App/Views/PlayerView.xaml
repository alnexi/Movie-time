<UserControl
    x:Class="MovieTime.App.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
    Background="#000000"
    IsTabStop="True">

    <UserControl.Resources>
        <!-- Liquid Glass Specular Rim Border Brush -->
        <LinearGradientBrush x:Key="LiquidGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0.0" />
            <GradientStop Color="#40FFFFFF" Offset="0.28" />
            <GradientStop Color="#15FFFFFF" Offset="0.75" />
            <GradientStop Color="#35FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Liquid Glass Translucent Surface Brush -->
        <LinearGradientBrush x:Key="LiquidGlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0.0" />
            <GradientStop Color="#18FFFFFF" Offset="0.5" />
            <GradientStop Color="#0CFFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Liquid Glass Chromatic Dispersion Hint -->
        <LinearGradientBrush x:Key="LiquidGlassDispersionBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1870D0FF" Offset="0.0" />
            <GradientStop Color="#00FFFFFF" Offset="0.5" />
            <GradientStop Color="#18FFA850" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Flyout Panel Glass Surface -->
        <LinearGradientBrush x:Key="LiquidGlassFlyoutSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8161622" Offset="0.0" />
            <GradientStop Color="#F00F0F18" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="PlayerRootGrid">

        <!-- ================= 1. NATIVE HARDWARE VIDEO SURFACE ================= -->
        <lvs:VideoView x:Name="LibVlcVideoView"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

        <!-- ================= 2. ATMOSPHERIC CINEMATIC VIGNETTE OVERLAYS ================= -->
        <!-- Top Gradient (Back button readability) -->
        <Grid VerticalAlignment="Top" Height="140" IsHitTestVisible="False"
              Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B0020204" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Bottom Gradient (Timeline & controls readability - Apple TV signature) -->
        <Grid VerticalAlignment="Bottom" Height="380" IsHitTestVisible="False"
              Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0" />
                    <GradientStop Color="#20040408" Offset="0.35" />
                    <GradientStop Color="#85030306" Offset="0.75" />
                    <GradientStop Color="#E6020204" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- ================= 3. TOP-LEFT FLOATING BACK BUTTON ================= -->
        <Button x:Name="BackButton"
                Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="48,36,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="18"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14,8,18,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="11" Foreground="#FFFFFF" />
                    <TextBlock Text="Movies" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Button>

        <!-- ================= 4. CENTER TRANSPORT CONTROLS (APPLE TV TRIAD) ================= -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">

                <!-- Previous in Playlist -->
                <Button Command="{x:Bind ViewModel.PlayPreviousInPlaylistCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPlaylistQueue, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.HasPreviousInPlaylist, Mode=OneWay}"
                        Width="48" Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="24"
                        ToolTipService.ToolTip="Previous in Playlist">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="{StaticResource LiquidGlassSurfaceBrush}"
                            BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE892;" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Skip 10s Backward -->
                <Button Command="{x:Bind ViewModel.SeekBackwardCommand, Mode=OneWay}"
                        Width="56" Height="56"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="28"
                        ToolTipService.ToolTip="Skip 10 Seconds Backward (Left Arrow)">
                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="{StaticResource LiquidGlassSurfaceBrush}"
                            BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEE35;" FontSize="20" Foreground="#FFFFFF" />
                            <TextBlock Text="10" FontSize="9" FontWeight="Bold" Foreground="#D0D0D8" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Primary Play / Pause Button -->
                <Button Command="{x:Bind ViewModel.PlayPauseCommand, Mode=OneWay}"
                        Width="72" Height="72"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="36"
                        ToolTipService.ToolTip="Play / Pause (Space)">
                    <Grid Width="72" Height="72">
                        <!-- Glass Base -->
                        <Border CornerRadius="36"
                                Background="{StaticResource LiquidGlassSurfaceBrush}"
                                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                BorderThickness="1.5" />
                        <!-- Subtle Chromatic Rim -->
                        <Border CornerRadius="36"
                                BorderBrush="{StaticResource LiquidGlassDispersionBrush}"
                                BorderThickness="1"
                                Margin="1" />
                        <!-- Icon -->
                        <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                  FontSize="28"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="2,0,0,0" />
                    </Grid>
                </Button>

                <!-- Skip 10s Forward -->
                <Button Command="{x:Bind ViewModel.SeekForwardCommand, Mode=OneWay}"
                        Width="56" Height="56"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="28"
                        ToolTipService.ToolTip="Skip 10 Seconds Forward (Right Arrow)">
                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="{StaticResource LiquidGlassSurfaceBrush}"
                            BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEE36;" FontSize="20" Foreground="#FFFFFF" />
                            <TextBlock Text="10" FontSize="9" FontWeight="Bold" Foreground="#D0D0D8" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Next in Playlist -->
                <Button Command="{x:Bind ViewModel.PlayNextInPlaylistCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPlaylistQueue, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.HasNextInPlaylist, Mode=OneWay}"
                        Width="48" Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="24"
                        ToolTipService.ToolTip="Next in Playlist">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="{StaticResource LiquidGlassSurfaceBrush}"
                            BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE893;" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 5. BOTTOM CINEMATIC HUD (APPLE TV SPECIFICATION) ================= -->
        <Grid VerticalAlignment="Bottom"
              Margin="60,0,60,38"
              Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <StackPanel Spacing="16">

                <!-- A. Title & Header Action Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Episode/Movie Context + Bold Title (Matches Screenshot 1 & 2) -->
                    <StackPanel Spacing="3" VerticalAlignment="Bottom">
                        <!-- Context line (e.g. S1, E1 • Something's Changed or 2023 • 4K UHD • HEVC) -->
                        <TextBlock Text="{x:Bind ViewModel.ContextSubtitle, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#C0C0C8"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Large Bold Title -->
                        <TextBlock Text="{x:Bind ViewModel.MovieTitle, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Right: Circular Liquid Glass Quick Action Buttons (Volume, Speed, Subtitles, Audio, Fullscreen) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Bottom">

                        <!-- I-03: Minimal Volume Control (0-200%) -->
                        <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Height="40"
                                Padding="8,2,10,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}"
                                        Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="13"
                                        ToolTipService.ToolTip="Mute / Unmute (M)">
                                    <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="13" Foreground="#FFFFFF" />
                                </Button>
                                <Slider x:Name="VolumeSlider"
                                        Minimum="0" Maximum="200"
                                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                        Width="84" Height="32"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Volume 0–200%">
                                    <Slider.Resources>
                                        <SolidColorBrush x:Key="SliderTrackFill" Color="#30FFFFFF" />
                                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF" />
                                        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                                    </Slider.Resources>
                                </Slider>
                                <TextBlock Text="{x:Bind ViewModel.VolumePercentDisplay, Mode=OneWay}"
                                           FontSize="11" FontWeight="Medium" Foreground="#CCCCCC"
                                           Width="34" VerticalAlignment="Center" TextAlignment="Right" />
                            </StackPanel>
                        </Border>

                        <!-- I-02: Playback Speed Control Pill (0.1x to 2.0x) -->
                        <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Height="40"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.DecreaseSpeedCommand, Mode=OneWay}"
                                        Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="13"
                                        ToolTipService.ToolTip="Decrease speed (-0.1x)">
                                    <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="#CCCCCC" />
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.PlaybackRateDisplay, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center" Margin="2,0" />
                                <Button Command="{x:Bind ViewModel.IncreaseSpeedCommand, Mode=OneWay}"
                                        Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="13"
                                        ToolTipService.ToolTip="Increase speed (+0.1x)">
                                    <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#CCCCCC" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Subtitles Button (💬 Speech Bubble with text) -->
                        <Button Command="{x:Bind ViewModel.ToggleSubtitleMenuCommand, Mode=OneWay}"
                                Width="44" Height="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="22"
                                ToolTipService.ToolTip="Subtitles">
                            <Border Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xE8BD;" FontSize="17" Foreground="#FFFFFF" />
                            </Border>
                        </Button>

                        <!-- Audio Options Button ((((|||))) Waveform / Sound Wave) -->
                        <Button Command="{x:Bind ViewModel.ToggleAudioMenuCommand, Mode=OneWay}"
                                Width="44" Height="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="22"
                                ToolTipService.ToolTip="Audio Options">
                            <Border Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xEC4F;" FontSize="18" Foreground="#FFFFFF" />
                            </Border>
                        </Button>

                        <!-- Fullscreen / PiP Button (⤢) -->
                        <Button Command="{x:Bind ViewModel.ToggleFullscreenCommand, Mode=OneWay}"
                                Width="44" Height="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="22"
                                ToolTipService.ToolTip="Toggle Fullscreen (F)">
                            <Border Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xE740;" FontSize="16" Foreground="#FFFFFF" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- B. Scrubber Timeline Bar (Apple TV Minimal Liquid Glass Progress Bar) -->
                <Grid x:Name="TimelineContainer"
                      Height="36"
                      VerticalAlignment="Center"
                      Background="Transparent">
                    <Slider x:Name="TimelineSlider"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.0001"
                            Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Height="36"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="TimelineSlider_ValueChanged">
                        <Slider.Resources>
                            <!-- Sleek Apple TV Liquid Glass White Track & Thumb Colors -->
                            <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#55FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#66FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EAEAEA" />
                        </Slider.Resources>
                    </Slider>
                </Grid>

                <!-- C. Playhead Indicators & Bottom Action Pills Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Apple TV Glass Action Pills (Info, InSight, Back / Continue Watching) -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                        <!-- Info Pill -->
                        <Button Command="{x:Bind ViewModel.ToggleInfoCommand, Mode=OneWay}"
                                Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18">
                            <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16,8">
                                <TextBlock Text="Info" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </Button>

                        <!-- InSight Pill -->
                        <Button Command="{x:Bind ViewModel.ToggleInfoCommand, Mode=OneWay}"
                                Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18">
                            <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16,8">
                                <TextBlock Text="InSight" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </Button>

                        <!-- Continue Watching / Return to Details Pill -->
                        <Button Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                                Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18">
                            <Border Background="{StaticResource LiquidGlassSurfaceBrush}"
                                    BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18,8">
                                <TextBlock Text="Continue Watching" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Center / Playhead Elapsed Indicator (Matches Screenshot 1: 04:33 ⏸) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E8E8" />
                        <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                  FontSize="10"
                                  Foreground="#A0A0A8"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Remaining Time Indicator (Matches Screenshot 1 & 2: -54:08 / -08:07) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.RemainingTimeDisplay, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E8E8" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ================= 5.5 FLOATING PLAYBACK SPEED HUD ================= -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,48,150"
                CornerRadius="16"
                Background="{StaticResource LiquidGlassFlyoutSurfaceBrush}"
                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                BorderThickness="1"
                Padding="16,8"
                Visibility="{x:Bind ViewModel.IsSpeedHudVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC48;" FontSize="14" Foreground="#FFFFFF" />
                <TextBlock Text="{x:Bind ViewModel.SpeedHudText, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
            </StackPanel>
        </Border>

        <!-- ================= 6. LIQUID GLASS FLYOUT MENUS ================= -->

        <!-- A. Subtitles Popover Menu -->
        <Border x:Name="SubtitleMenuPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,100,130"
                Width="320"
                MaxHeight="500"
                CornerRadius="16"
                Background="{StaticResource LiquidGlassFlyoutSurfaceBrush}"
                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Visibility="{x:Bind ViewModel.IsSubtitleMenuOpen, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Subtitles" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ToggleSubtitleMenuCommand, Mode=OneWay}"
                                Padding="4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#8A8A98" />
                        </Button>
                    </Grid>

                    <!-- Subtitle Tracks List -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SubtitleTracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="CorePlayback:PlayerTrackInfo"
                                          xmlns:CorePlayback="using:MovieTime.Core.Playback">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,8"
                                        Margin="0,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Click="OnSubtitleTrackItemClicked">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="12" Foreground="#FFFFFF"
                                                  Visibility="{x:Bind IsSelected}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="#20FFFFFF" />

                    <!-- External Subtitle Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="External Subtitle" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.ExternalSubtitleFileName, Mode=OneWay}"
                                       FontSize="12" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.HasExternalSubtitle, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveExternalSubtitleCommand, Mode=OneWay}"
                                    Padding="8,4" Background="#30FF4D4D" BorderThickness="0" CornerRadius="6">
                                <TextBlock Text="Remove" FontSize="11" Foreground="#FF6B6B" />
                            </Button>
                        </Grid>
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadExternalSubtitleCommand, Mode=OneWay}"
                                Background="{StaticResource LiquidGlassSurfaceBrush}"
                                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F4;" FontSize="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Load Subtitle File (SRT, ASS, VTT)..." FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#20FFFFFF" />

                    <!-- Subtitle Appearance Customization Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Subtitle Appearance" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />

                        <!-- Size Preset Buttons -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Size" FontSize="10" Foreground="#A0A0A8" />
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Small" Click="OnSubtitleSizeSmallClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="1" Content="Medium" Click="OnSubtitleSizeMediumClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="2" Content="Large" Click="OnSubtitleSizeLargeClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="3" Content="XL" Click="OnSubtitleSizeExtraLargeClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                            </Grid>
                        </StackPanel>

                        <!-- Color Preset Buttons -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Color" FontSize="10" Foreground="#A0A0A8" />
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="White" Click="OnSubtitleColorWhiteClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="#20FFFFFF" BorderThickness="0" Foreground="#FFFFFF" />
                                <Button Grid.Column="1" Content="Yellow" Click="OnSubtitleColorYellowClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="#20FFE500" BorderThickness="0" Foreground="#FFE500" />
                                <Button Grid.Column="2" Content="Cyan" Click="OnSubtitleColorCyanClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="#2000E5FF" BorderThickness="0" Foreground="#00E5FF" />
                                <Button Grid.Column="3" Content="Green" Click="OnSubtitleColorGreenClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="#2000E676" BorderThickness="0" Foreground="#00E676" />
                            </Grid>
                        </StackPanel>

                        <!-- Outline Preset Buttons -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Outline" FontSize="10" Foreground="#A0A0A8" />
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Off" Click="OnSubtitleOutlineOffClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="1" Content="Thin" Click="OnSubtitleOutlineThinClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="2" Content="Medium" Click="OnSubtitleOutlineMediumClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="3" Content="Thick" Click="OnSubtitleOutlineThickClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                            </Grid>
                        </StackPanel>

                        <!-- Background Preset Buttons -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Background" FontSize="10" Foreground="#A0A0A8" />
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Off" Click="OnSubtitleBgOffClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="1" Content="Subtle" Click="OnSubtitleBgSubtleClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                                <Button Grid.Column="2" Content="Dark" Click="OnSubtitleBgDarkClicked"
                                        FontSize="10" Padding="0,4" Margin="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                        Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Styling applies to text subtitles (SRT/VTT). Embedded ASS/SSA styles are preserved."
                                   FontSize="9" Foreground="#7E7E88" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- B. Audio Options Popover Menu -->
        <Border x:Name="AudioMenuPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,60,130"
                Width="320"
                MaxHeight="500"
                CornerRadius="16"
                Background="{StaticResource LiquidGlassFlyoutSurfaceBrush}"
                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                BorderThickness="1"
                Padding="16"
                Visibility="{x:Bind ViewModel.IsAudioMenuOpen, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Audio Tracks" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ToggleAudioMenuCommand, Mode=OneWay}"
                                Padding="4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#8A8A98" />
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.AudioTracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="CorePlayback:PlayerTrackInfo"
                                          xmlns:CorePlayback="using:MovieTime.Core.Playback">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,8"
                                        Margin="0,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Click="OnAudioTrackItemClicked">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="12" Foreground="#FFFFFF"
                                                  Visibility="{x:Bind IsSelected}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="#20FFFFFF" />

                    <!-- External Audio / Dubbed Audio Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="External Dubbed Audio" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.ExternalAudioFileName, Mode=OneWay}"
                                       FontSize="12" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.HasExternalAudio, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveExternalAudioCommand, Mode=OneWay}"
                                    Padding="8,4" Background="#30FF4D4D" BorderThickness="0" CornerRadius="6">
                                <TextBlock Text="Remove" FontSize="11" Foreground="#FF6B6B" />
                            </Button>
                        </Grid>
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadExternalAudioCommand, Mode=OneWay}"
                                Background="{StaticResource LiquidGlassSurfaceBrush}"
                                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Load Audio File (MKA, AC3, MP3)..." FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#20FFFFFF" />

                    <!-- Audio Delay / Synchronization Section -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Audio Synchronization" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.AudioDelayDisplay, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="- 100 ms" Click="OnAudioDelayMinusClicked"
                                    FontSize="11" Padding="0,6" Margin="2" HorizontalAlignment="Stretch" CornerRadius="6"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                            <Button Grid.Column="1" Content="+ 100 ms" Click="OnAudioDelayPlusClicked"
                                    FontSize="11" Padding="0,6" Margin="2" HorizontalAlignment="Stretch" CornerRadius="6"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#E0E0E0" />
                            <Button Grid.Column="2" Content="Reset (0ms)" Click="OnAudioDelayResetClicked"
                                    FontSize="11" Padding="0,6" Margin="2" HorizontalAlignment="Stretch" CornerRadius="6"
                                    Background="{StaticResource LiquidGlassSurfaceBrush}" BorderThickness="0" Foreground="#A0A0A8" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- C. InSight / Media Information & Shortcuts Popover Card -->
        <Border x:Name="InfoPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="60,0,0,120"
                Width="420"
                MaxHeight="520"
                CornerRadius="18"
                Background="{StaticResource LiquidGlassFlyoutSurfaceBrush}"
                BorderBrush="{StaticResource LiquidGlassBorderBrush}"
                BorderThickness="1"
                Padding="20"
                Visibility="{x:Bind ViewModel.IsInfoOpen, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Media InSight &amp; Shortcuts" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ToggleInfoCommand, Mode=OneWay}"
                                Padding="4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#8A8A98" />
                        </Button>
                    </Grid>

                    <!-- Technical Metadata -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Title" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.MovieTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Resolution" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.ResolutionDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Video Codec" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.VideoCodecDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Audio Codec" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.AudioCodecDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Format" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.FormatDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="File Size" FontSize="11" Foreground="#8E8E93" />
                            <TextBlock Text="{x:Bind ViewModel.FileSizeDisplay, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#20FFFFFF" />

                    <!-- YouTube-Style Shortcuts Reference -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Keyboard Shortcuts (YouTube-Style)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Space / K  •  Play / Pause" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="J / L  •  Seek 10s" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="← / →  •  Seek 5s" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="0 - 9  •  Seek 0% - 90%" FontSize="11" Foreground="#C0C0C8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="F  •  Toggle Fullscreen" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="M  •  Toggle Mute" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="↑ / ↓  •  Volume ±5%" FontSize="11" Foreground="#C0C0C8" />
                                <TextBlock Text="Esc  •  Back / Exit Fullscreen" FontSize="11" Foreground="#C0C0C8" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 7. ERROR STATE OVERLAY ================= -->
        <Border Background="#D0050508"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18"
                        MaxWidth="460">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF5B5B" HorizontalAlignment="Center" />
                <TextBlock Text="Playback Unavailable" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           FontSize="13"
                           Foreground="#A0A0A8"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Background="#FFFFFF"
                        CornerRadius="20"
                        Padding="24,10">
                    <TextBlock Text="Return to Details" FontSize="13" FontWeight="SemiBold" Foreground="#000000" />
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
