<UserControl
    x:Class="MovieTime.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MovieTime.App.Controls"
    xmlns:vm="using:MovieTime.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">

    <Grid Background="#0A0A0C">
        <!-- 1. Main Scrollable Content Canvas (Hero + Movie Rows) -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel Padding="0,0,0,60">
                <!-- Apple TV Hero Billboard Section -->
                <controls:HeroBannerControl ViewModel="{x:Bind ViewModel.Hero, Mode=OneWay}" />

                <!-- Empty Library Guidance Callout (when no local files scanned yet) -->
                <Border Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}"
                        Background="#14141A"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="48,8,48,8"
                        Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="10"
                                Background="#2A2A38"
                                Margin="0,0,16,0">
                            <FontIcon Glyph="&#xE714;" FontSize="20" Foreground="#E0E0FF" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="No Local Movies Found"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="Connect your storage drives and add an MLibrary folder in Settings to start cataloging and enjoying your local media collection."
                                       FontSize="12"
                                       Foreground="#8E8E93" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.ManageLibrariesCommand}"
                                    Background="#FFFFFF"
                                    Foreground="#000000"
                                    CornerRadius="12"
                                    Padding="16,8"
                                    FontSize="12"
                                    FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                                    <TextBlock Text="Manage Libraries" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.RefreshLibraryCommand}"
                                    Background="#25FFFFFF"
                                    Foreground="#FFFFFF"
                                    CornerRadius="12"
                                    Padding="14,8"
                                    FontSize="12"
                                    FontWeight="Medium">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    <TextBlock Text="Scan Now" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Horizontal Content Rows (Continue Watching, Top Movies, etc.) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaRowViewModel">
                            <controls:MediaRowControl ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Apple TV Floating Pill Button: ( 🏠 Home ) - Screenshot 1 -->
        <!-- Placed top-left, opens the sidebar when clicked -->
        <Button Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="36,28,0,0"
                Background="#60181820"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12,6,16,6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="#C0C0C8" />
                <FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="#FFFFFF" />
                <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
            </StackPanel>
        </Button>

        <!-- 3. Sidebar Backdrop Dimmer (click outside to close sidebar) -->
        <Border Background="#60000000"
                Visibility="{x:Bind ViewModel.IsSidebarOpen, Mode=OneWay}"
                PointerPressed="OnBackdropPointerPressed" />

        <!-- 4. Floating Apple TV Sidebar Panel - Screenshot 2 -->
        <controls:SidebarNavigationControl ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
