<Window x:Class="MovieTime.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="River Setup"
        Width="750" Height="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="Assets/app.ico">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BoatFloatTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-7"
                                     Duration="0:0:1.8"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Main Outer Window Border with Rounded Corners & Shadow -->
    <Border CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#30363D"
            ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush Color="#080A0E" />
        </Border.Background>

        <Grid>
            <!-- Atmospheric Dark Night Backdrop -->
            <Image Source="Assets/night_scene_clean.png"
                   Opacity="0.22"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

            <!-- Dark Gradient Vignette for Liquid Glass Atmosphere -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#00000000" Offset="0.1" />
                        <GradientStop Color="#CC080A0E" Offset="0.7" />
                        <GradientStop Color="#F0080A0E" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom Header / Window Titlebar -->
                <Border Grid.Row="0"
                        Background="#10141D"
                        BorderBrush="#1F2937"
                        BorderThickness="0,0,0,1"
                        MouseDown="OnTitleBarMouseDown">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Header -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,10,0" />
                            <TextBlock Text="RIVER"
                                       FontFamily="{StaticResource SegoeUIVariable}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Border Background="#1E293B"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v1.2.3 Setup"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>

                        <!-- Window Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowMinButtonStyle}"
                                    Click="OnMinimizeClick"
                                    Margin="0,0,6,0"
                                    ToolTip="Minimize" />
                            <Button Style="{StaticResource WindowCloseButtonStyle}"
                                    Click="OnCloseClick"
                                    ToolTip="Close" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Stage Area -->
                <Grid Grid.Row="1" Margin="24">

                    <!-- ======================================================== -->
                    <!-- 1. WELCOME SCREEN                                         -->
                    <!-- ======================================================== -->
                    <Grid x:Name="WelcomePanel" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Hero Column: Pixel-Art Sailboat & Scene Showcase -->
                        <Border Grid.Column="0"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="#1F2937"
                                Margin="0,0,20,0"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#121824" Offset="0" />
                                    <GradientStop Color="#0A0E14" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- Subtle reflection glow -->
                                <Ellipse Width="180" Height="40"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,90"
                                         Fill="#1038BDF8"
                                         Opacity="0.4" />

                                <!-- Pixel Boat with Float Animation -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="140" Height="140"
                                            CornerRadius="16"
                                            Background="#101E2E"
                                            BorderThickness="1"
                                            BorderBrush="#1E2D42"
                                            Padding="10">
                                        <Image Source="Assets/sailboat_night.png"
                                               Width="110" Height="110"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Image.RenderTransform>
                                                <TranslateTransform x:Name="BoatFloatTransform" Y="0" />
                                            </Image.RenderTransform>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="RIVER MEDIA"
                                               FontFamily="{StaticResource SegoeUIVariable}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#475569"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right Column: Welcome Description & Options -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="WelcomeTitleText"
                                           Text="Welcome to River"
                                           FontFamily="{StaticResource SegoeUIVariable}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="WelcomeSubtitleText"
                                           Text="Modern Cinematic Offline Media Player"
                                           FontFamily="{StaticResource SegoeUIVariable}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Feature Overview Cards -->
                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock x:Name="WelcomeDescText"
                                           Text="River delivers a fast, private, offline-first media experience for your local movie and TV show library on Windows."
                                           FontSize="12.5"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,0,0,16" />

                                <Border Background="#0F172A"
                                        BorderThickness="1"
                                        BorderBrush="#1E293B"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Engine &amp; Capabilities"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="• Embedded LibVLC native codecs — plays all formats"
                                                   FontSize="11.5"
                                                   Foreground="#CBD5E1"
                                                   Margin="0,2" />
                                        <TextBlock Text="• Automatic real-time library synchronization"
                                                   FontSize="11.5"
                                                   Foreground="#CBD5E1"
                                                   Margin="0,2" />
                                        <TextBlock Text="• 100% offline &amp; private — zero online telemetry"
                                                   FontSize="11.5"
                                                   Foreground="#CBD5E1"
                                                   Margin="0,2" />
                                        <TextBlock Text="• Liquid Glass dark aesthetic with Theme Experience"
                                                   FontSize="11.5"
                                                   Foreground="#CBD5E1"
                                                   Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Bottom Action Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Customize..."
                                        Click="OnCustomizeClick"
                                        Margin="0,0,12,0" />
                                <Button x:Name="QuickInstallButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Install River"
                                        Click="OnQuickInstallClick" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 2. OPTIONS / CUSTOM INSTALL SCREEN                        -->
                    <!-- ======================================================== -->
                    <Grid x:Name="OptionsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Installation Options"
                                       FontFamily="{StaticResource SegoeUIVariable}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Choose where River will be installed and configure shortcuts."
                                       FontSize="12.5"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Options Body -->
                        <StackPanel Grid.Row="1">
                            <!-- Installation Directory Group -->
                            <Border Background="#0F172A"
                                    BorderThickness="1"
                                    BorderBrush="#1E293B"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="INSTALLATION LOCATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathTextBox"
                                                 Grid.Column="0"
                                                 Height="36"
                                                 VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Browse..."
                                                Height="36"
                                                Padding="16,0"
                                                Margin="10,0,0,0"
                                                Click="OnBrowseClick" />
                                    </Grid>
                                    <TextBlock x:Name="SpaceStatsText"
                                               Text="Space Required: ~310 MB  |  Drive Available: Checking..."
                                               FontSize="11.5"
                                               Foreground="#94A3B8"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Preferences Group -->
                            <Border Background="#0F172A"
                                    BorderThickness="1"
                                    BorderBrush="#1E293B"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="SHORTCUTS &amp; INTEGRATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               Margin="0,0,0,12" />
                                    <CheckBox x:Name="DesktopShortcutCheck"
                                              Content="Create Desktop shortcut"
                                              IsChecked="True"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="StartMenuShortcutCheck"
                                              Content="Create Start Menu shortcut"
                                              IsChecked="True"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="FileAssociationsCheck"
                                              Content="Register River in Windows 'Open With' for video files"
                                              IsChecked="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Navigation Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Back"
                                    Click="OnBackToWelcomeClick"
                                    Margin="0,0,12,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Install Now"
                                    Click="OnStartInstallClick" />
                        </StackPanel>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 3. INSTALLING / PROGRESS SCREEN                           -->
                    <!-- ======================================================== -->
                    <Grid x:Name="InstallingPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <TextBlock Text="Installing River..."
                                       FontFamily="{StaticResource SegoeUIVariable}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Deploying the River application engine, LibVLC codecs, and dependencies."
                                       FontSize="12.5"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Progress Display Area -->
                        <Border Grid.Row="1"
                                Background="#0F172A"
                                BorderThickness="1"
                                BorderBrush="#1E293B"
                                CornerRadius="12"
                                Padding="28,24"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="StatusLabel"
                                               Text="Extracting application files..."
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock x:Name="PercentageLabel"
                                               Text="0%"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#38BDF8"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Custom Liquid Glass Progress Bar Track -->
                                <Border Height="10"
                                        CornerRadius="5"
                                        Background="#161B22"
                                        BorderThickness="1"
                                        BorderBrush="#21262D"
                                        ClipToBounds="True">
                                    <Grid HorizontalAlignment="Left" x:Name="ProgressBarFillGrid" Width="0">
                                        <Border CornerRadius="5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0284C7" Offset="0" />
                                                    <GradientStop Color="#38BDF8" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Detail text -->
                                <TextBlock x:Name="DetailLabel"
                                           Text="Preparing extraction pipeline..."
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 4. FINISHED / SUCCESS SCREEN                              -->
                    <!-- ======================================================== -->
                    <Grid x:Name="FinishedPanel" Visibility="Collapsed">
                        <Border Background="#0F172A"
                                BorderThickness="1"
                                BorderBrush="#1E293B"
                                CornerRadius="12"
                                Padding="32,24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="580">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Success Emerald Icon -->
                                <Border Width="56" Height="56"
                                        CornerRadius="28"
                                        Background="#064E3B"
                                        BorderThickness="1"
                                        BorderBrush="#10B981"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <Path Data="M 16,28 L 24,36 L 40,20"
                                          Stroke="#10B981"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <TextBlock x:Name="FinishTitleText"
                                           Text="Installation Complete!"
                                           FontFamily="{StaticResource SegoeUIVariable}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="FinishSubtitleText"
                                           Text="River has been successfully installed and is ready to use."
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,16" />

                                <Border Background="#161B22"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        BorderThickness="1"
                                        BorderBrush="#21262D"
                                        Margin="0,0,0,18">
                                    <TextBlock x:Name="InstalledPathText"
                                               Text="Installed to: C:\Program Files\River"
                                               FontSize="11.5"
                                               Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <CheckBox x:Name="LaunchAfterCheck"
                                          Content="Launch River now"
                                          IsChecked="True"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,24" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Finish"
                                            Width="160"
                                            Click="OnFinishClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 5. ERROR SCREEN                                           -->
                    <!-- ======================================================== -->
                    <Grid x:Name="ErrorPanel" Visibility="Collapsed">
                        <Border Background="#161B22"
                                BorderThickness="1"
                                BorderBrush="#7F1D1D"
                                CornerRadius="12"
                                Padding="32,24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="580">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Error Red Icon -->
                                <Border Width="56" Height="56"
                                        CornerRadius="28"
                                        Background="#450A0A"
                                        BorderThickness="1"
                                        BorderBrush="#EF4444"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <Path Data="M 18,18 L 38,38 M 38,18 L 18,38"
                                          Stroke="#EF4444"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="Installation Failed"
                                           FontFamily="{StaticResource SegoeUIVariable}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ErrorMessageText"
                                           Text="An unexpected error occurred during installation."
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,16" />

                                <ScrollViewer MaxHeight="80" Margin="0,0,0,20">
                                    <TextBox x:Name="ErrorDetailBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             FontSize="11"
                                             Foreground="#EF4444"
                                             Background="#0D1117"
                                             BorderThickness="1"
                                             BorderBrush="#21262D" />
                                </ScrollViewer>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Close"
                                            Width="120"
                                            Margin="0,0,12,0"
                                            Click="OnCloseClick" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Retry"
                                            Width="120"
                                            Click="OnRetryClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
